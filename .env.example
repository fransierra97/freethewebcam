# Generated by ./install.sh. Manual copy: cp .env.example .env, fill it in and run ./ftw up
DOMAIN=cams.example.com
ACME_EMAIL=your-email@example.com
PUBLIC_URL=https://cams.example.com
LIVEKIT_URL=wss://cams.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
APP_SECRET=
SETUP_TOKEN=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
NODE_ENV=production
# Header with the visitor's country (Cloudflare sends it as cf-ipcountry).
# Without it, all visitors count as “unknown country” and the strictest rule applies.
GEO_HEADER=cf-ipcountry
DEFAULT_COUNTRY=
# X-Forwarded-For is only trusted if the request comes from these networks (local proxy / internal network).
TRUST_PROXY=loopback,uniquelocal
# Optional services (./ftw enable obs|recording|turn)
FTW_OBS=0
FTW_RECORDING=0
FTW_TURN=0
INGRESS_ENABLED=0
EGRESS_ENABLED=0
