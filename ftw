#!/usr/bin/env bash
# Administration of a FreeTheWebcam installation.
#   ./ftw up                 generates the configuration and starts (or applies changes)
#   ./ftw status | logs [service] | restart
#   ./ftw update             backup + update the code + restart
#   ./ftw backup [--media]   back up the database and data (and recordings with --media)
#   ./ftw restore <db.sql.gz> [data.tgz]
#   ./ftw enable|disable obs|recording|turn
#   ./ftw config             only regenerates livekit.yaml, ingress.yaml and egress.yaml
#   ./ftw cron               recommended scheduled tasks
set -euo pipefail
cd "$(dirname "$0")"

say() { printf '\n\033[1m%s\033[0m\n' "$*"; }
die() { printf '\nError: %s\n' "$*" >&2; exit 1; }

[[ -f .env ]] || die "missing .env: run ./install.sh first"
set -a
# shellcheck disable=SC1091
source .env
set +a

FTW_OBS="${FTW_OBS:-0}"
FTW_RECORDING="${FTW_RECORDING:-0}"
FTW_TURN="${FTW_TURN:-0}"
BACKUP_DIR="${FTW_BACKUP_DIR:-./backups}"
BACKUP_KEEP="${FTW_BACKUP_KEEP:-14}"
CERT_DIR="/caddy/caddy/certificates/acme-v02.api.letsencrypt.org-directory/${DOMAIN}"

compose() {
  local profiles=()
  [[ "$FTW_OBS" == "1" ]] && profiles+=(--profile obs)
  [[ "$FTW_RECORDING" == "1" ]] && profiles+=(--profile recording)
  docker compose "${profiles[@]}" "$@"
}

set_env() { # set_env KEY value
  if grep -q "^$1=" .env; then
    sed -i.bak "s|^$1=.*|$1=$2|" .env && rm -f .env.bak
  else
    echo "$1=$2" >> .env
  fi
  export "$1=$2"
}

render_config() {
  umask 022
  {
    echo "# Generated by ./ftw config: do not edit by hand."
    echo "port: 7880"
    echo "rtc:"
    echo "  tcp_port: 7881"
    echo "  port_range_start: 50000"
    echo "  port_range_end: 60000"
    echo "  use_external_ip: true"
    echo "redis:"
    echo "  address: 127.0.0.1:6379"
    echo "  password: ${REDIS_PASSWORD}"
    echo "keys:"
    echo "  ${LIVEKIT_API_KEY}: ${LIVEKIT_API_SECRET}"
    echo "webhook:"
    echo "  api_key: ${LIVEKIT_API_KEY}"
    echo "  urls:"
    echo "    - http://127.0.0.1:3000/webhooks/livekit"
    echo "logging:"
    echo "  level: info"
    if [[ "$FTW_OBS" == "1" ]]; then
      echo "ingress:"
      echo "  rtmp_base_url: rtmp://${DOMAIN}:1935/live"
      echo "  whip_base_url: https://${DOMAIN}/whip"
    fi
    if [[ "$FTW_TURN" == "1" ]]; then
      echo "turn:"
      echo "  enabled: true"
      echo "  domain: ${DOMAIN}"
      echo "  tls_port: 5349"
      echo "  udp_port: 3478"
      echo "  cert_file: ${CERT_DIR}/${DOMAIN}.crt"
      echo "  key_file: ${CERT_DIR}/${DOMAIN}.key"
    fi
  } > livekit.yaml

  {
    echo "# Generated by ./ftw config"
    echo "api_key: ${LIVEKIT_API_KEY}"
    echo "api_secret: ${LIVEKIT_API_SECRET}"
    echo "ws_url: ws://127.0.0.1:7880"
    echo "redis:"
    echo "  address: 127.0.0.1:6379"
    echo "  password: ${REDIS_PASSWORD}"
    echo "rtmp_port: 1935"
    echo "whip_port: 8080"
    echo "http_relay_port: 9090"
    echo "rtc_config:"
    echo "  udp_port: 7885"
    echo "logging:"
    echo "  level: info"
  } > ingress.yaml

  {
    echo "# Generated by ./ftw config"
    echo "api_key: ${LIVEKIT_API_KEY}"
    echo "api_secret: ${LIVEKIT_API_SECRET}"
    echo "ws_url: ws://127.0.0.1:7880"
    echo "insecure: true"
    echo "redis:"
    echo "  address: 127.0.0.1:6379"
    echo "  password: ${REDIS_PASSWORD}"
    echo "logging:"
    echo "  level: info"
  } > egress.yaml
  # Containers may run as another user: they must be able to read these files.
  chmod 644 livekit.yaml ingress.yaml egress.yaml
}

open_ports() {
  command -v ufw >/dev/null && ufw status 2>/dev/null | grep -q "Status: active" || {
    echo "Open in your firewall: $*"
    return
  }
  for p in "$@"; do ufw allow "$p" >/dev/null; done
}

backup() {
  mkdir -p "$BACKUP_DIR"
  local ts; ts="$(date +%Y%m%d-%H%M%S)"
  say "Backing up the database…"
  compose exec -T db pg_dump -U ftw ftw | gzip > "$BACKUP_DIR/db-$ts.sql.gz"
  say "Backing up data (performer records, moderation frames)…"
  compose run --rm --no-deps -T --entrypoint tar -v "$(cd "$BACKUP_DIR" && pwd):/backup" app czf "/backup/data-$ts.tgz" -C /data .
  if [[ "${1:-}" == "--media" ]]; then
    say "Backing up recordings (may be large)…"
    compose run --rm --no-deps -T --entrypoint tar -v "$(cd "$BACKUP_DIR" && pwd):/backup" app czf "/backup/media-$ts.tgz" -C /media .
  fi
  # Rotation: keep the last N backups of each kind.
  for kind in db data media; do
    ls -1t "$BACKUP_DIR"/"$kind"-* 2>/dev/null | tail -n +"$((BACKUP_KEEP + 1))" | xargs -r rm -f
  done
  say "Backup saved in $BACKUP_DIR (db-$ts.sql.gz, data-$ts.tgz)."
  echo "IMPORTANT: also keep .env in a safe place. Without APP_SECRET the records cannot be decrypted."
}

restore() {
  local db="${1:-}" data="${2:-}"
  [[ -f "$db" ]] || die "specify the database backup: ./ftw restore backups/db-….sql.gz [backups/data-….tgz]"
  read -rp "This REPLACES the current database. Type “restore” to continue: " ok
  [[ "$ok" == "restore" ]] || die "cancelled"
  compose stop app
  compose exec -T db psql -U ftw -d postgres -c "drop database if exists ftw" -c "create database ftw owner ftw"
  gunzip -c "$db" | compose exec -T db psql -U ftw -d ftw -q
  if [[ -n "$data" ]]; then
    [[ -f "$data" ]] || die "cannot find $data"
    compose run --rm --no-deps -T --entrypoint sh -v "$(cd "$(dirname "$data")" && pwd):/backup" app \
      -c "rm -rf /data/* && tar xzf /backup/$(basename "$data") -C /data"
  fi
  compose up -d
  say "Restored."
}

feature() { # feature enable|disable obs|recording|turn
  local action="$1" name="${2:-}" value
  value=$([[ "$action" == "enable" ]] && echo 1 || echo 0)
  case "$name" in
    obs)
      set_env FTW_OBS "$value"; set_env INGRESS_ENABLED "$value"
      [[ "$value" == "1" ]] && open_ports 1935/tcp 7885/udp
      ;;
    recording)
      set_env FTW_RECORDING "$value"; set_env EGRESS_ENABLED "$value"
      ;;
    turn)
      if [[ "$value" == "1" ]]; then
        compose exec -T caddy test -f "/data/caddy/certificates/acme-v02.api.letsencrypt.org-directory/${DOMAIN}/${DOMAIN}.crt" \
          || die "Caddy does not have a certificate for ${DOMAIN} yet. Open https://${DOMAIN} once and try again."
        open_ports 3478/udp 5349/tcp
      fi
      set_env FTW_TURN "$value"
      ;;
    *) die "usage: ./ftw $action obs|recording|turn" ;;
  esac
  render_config
  if [[ "$action" == "disable" && "$name" != "turn" ]]; then
    local profile service
    profile=$([[ "$name" == obs ]] && echo obs || echo recording)
    service=$([[ "$name" == obs ]] && echo ingress || echo egress)
    docker compose --profile "$profile" rm -sf "$service"
  fi
  compose up -d --remove-orphans
  say "Done: $name $([[ $value == 1 ]] && echo enabled || echo disabled)."
}

case "${1:-}" in
  config) render_config; say "Configuration regenerated." ;;
  up) render_config; compose up -d --build --remove-orphans ;;
  status) compose ps ;;
  logs) shift; compose logs -f --tail=200 "$@" ;;
  restart) compose restart ;;
  update)
    backup
    say "Updating the code…"
    git pull --ff-only
    render_config
    compose up -d --build --remove-orphans
    say "Updated."
    ;;
  backup) shift; backup "${1:-}" ;;
  restore) shift; restore "$@" ;;
  enable|disable) feature "$1" "${2:-}" ;;
  cron)
    cat <<EOF
# Add these lines with “crontab -e” (as the user that manages Docker):
# Daily backup at 4:30
30 4 * * * cd $(pwd) && ./ftw backup >> backups/cron.log 2>&1
# Weekly LiveKit restart to pick up the renewed certificate (only if you use TURN)
0 5 * * 1 cd $(pwd) && docker compose restart livekit >/dev/null 2>&1
EOF
    ;;
  *)
    sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
    ;;
esac
